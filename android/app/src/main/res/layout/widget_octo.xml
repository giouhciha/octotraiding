<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#2DD4BF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="BTCUSDT" />

    <TextView
        android:id="@+id/widget_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#E6ECF5"
        android:textSize="26sp"
        android:textStyle="bold"
        android:text="—" />

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#93A4C0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Sin datos" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="#6B7A97"
        android:textSize="11sp"
        android:text="Abre la app para analizar" />

</LinearLayout>
